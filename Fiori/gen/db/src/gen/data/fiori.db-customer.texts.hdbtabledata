          "delimiter": ","
        }
      },
      "import_settings": {
        "import_columns": [
          "LOCALE",
          "ID",
          "NAME",
          "ADDRESS"
        ],
        "include_filter": []
      },
      "column_mappings": {
        "LOCALE": "locale",
        "ID": "ID",
        "NAME": "name",
        "ADDRESS": "address"
      }
    }
  ]
}