COLUMN TABLE fiori_srv_fiori_api_customers_drafts (
  ID NVARCHAR(5000) NOT NULL,
  name NVARCHAR(5000) NULL,
  status NVARCHAR(5000) NULL,
  address NVARCHAR(5000) NULL,
  email NVARCHAR(5000) NULL,
  contact INTEGER NULL,
  criticality INTEGER NULL,
  File BLOB NULL,
  filetype NVARCHAR(255) NULL,
  fileName NVARCHAR(255) NULL,
  imageUrl NVARCHAR(5000) NULL,
  BookDetails_id NVARCHAR(5000) NULL,
  IsActiveEntity BOOLEAN,
  HasActiveEntity BOOLEAN,
  HasDraftEntity BOOLEAN,
  DraftAdministrativeData_DraftUUID NVARCHAR(36) NOT NULL,
  PRIMARY KEY(ID)
)