{
  "format_version": 1,
  "imports": [
    {
      "target_table": "STU_DB_STUDENT",
      "source_data": {
        "data_type": "CSV",
        "file_name": "stu.db-student.csv",
        "has_header": true,
        "type_config": {
          "delimiter": ","
        }
      },
      "import_settings": {
        "import_columns": [
          "ID",
          "NAME",
          "AGE",
          "ADDRESS",
          "PINCODE",
          "LATITUDE",
          "LONGITUDE"
        ],
        "include_filter": []
      },
      "column_mappings": {
        "ID": "ID",
        "NAME": "name",
        "AGE": "age",
        "ADDRESS": "address",
        "PINCODE": "pincode",
        "LATITUDE": "latitude",
        "LONGITUDE": "longitude"
      }
    }
  ]
}